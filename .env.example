# Database (Supabase PostgreSQL)
# Connection pooler URL (for app queries - pgBouncer)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# Direct connection URL (for migrations)
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

# Admin panel hidden path segment (no slashes)
# URL will be: /panel-x7k2mq
ADMIN_PATH="panel-x7k2mq"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Next.js
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Store info
NEXT_PUBLIC_STORE_NAME="UrbanStore"
NEXT_PUBLIC_STORE_ADDRESS="C. Nueve de Mayo, 15, 33002 Oviedo, Asturias"
NEXT_PUBLIC_STORE_PHONE="+34 984 000 000"
NEXT_PUBLIC_STORE_INSTAGRAM="https://instagram.com/urbanstore_oviedo"

# Seed admin account (only used by prisma/seed.ts)
ADMIN_EMAIL="admin@urbanstore.es"
ADMIN_PASSWORD="admin123"
