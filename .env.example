# Database
# Local dev:  DATABASE_URL="file:./dev.db"
# Production: DATABASE_URL="libsql://your-db.turso.io"
DATABASE_URL="file:./dev.db"

# Turso auth token (required in production, leave empty for local SQLite)
TURSO_AUTH_TOKEN=""

# Admin panel hidden path segment (no slashes)
# URL will be: /panel-x7k2mq
ADMIN_PATH="panel-x7k2mq"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Vercel Blob Storage (get token from Vercel dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=""

# Next.js
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Store info
NEXT_PUBLIC_STORE_NAME="UrbanStore"
NEXT_PUBLIC_STORE_ADDRESS="C. Nueve de Mayo, 15, 33002 Oviedo, Asturias"
NEXT_PUBLIC_STORE_PHONE="+34 984 000 000"
NEXT_PUBLIC_STORE_INSTAGRAM="https://instagram.com/urbanstore_oviedo"

# Seed admin account (only used by prisma/seed.ts)
ADMIN_EMAIL="admin@urbanstore.es"
ADMIN_PASSWORD="admin123"
